{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["hr_assistant.api:app", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "CLI ask (E1002)",
      "type": "debugpy",
      "request": "launch",
      "module": "hr_assistant.ask",
      "args": ["--employee", "E1002"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}